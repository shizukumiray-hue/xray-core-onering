    "13_too_many_isps": {
      "description": "Provider has more than 20 ISPs",
      "error_expected": "has too many ISPs (max 20)",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {
                  "name": "test",
                  "bugDomain": "example.com",
                  "isps": ["isp1","isp2","isp3","isp4","isp5","isp6","isp7","isp8","isp9","isp10","isp11","isp12","isp13","isp14","isp15","isp16","isp17","isp18","isp19","isp20","isp21"]
                }
              ]
            }
          }
        }
      }
    }
  },
  "valid_examples": {
    "minimal_config": {
      "description": "Minimal valid multi-CDN config",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {"name": "cloudflare", "bugDomain": "zoom.us"}
              ]
            }
          }
        }
      }
    },
    "full_config": {
      "description": "Complete valid multi-CDN config with all options",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "strategy": "health-based",
              "providers": [
                {
                  "name": "cloudflare",
                  "bugDomain": "zoom.us",
                  "priority": 100,
                  "isps": ["telkomsel", "indosat"]
                },
                {
                  "name": "cloudfront",
                  "bugDomain": "aws.amazon.com",
                  "priority": 90,
                  "isps": ["xl", "smartfren"]
                }
              ],
              "healthCheck": {
                "enabled": true,
                "interval": "30s",
                "timeout": "5s",
                "url": "https://cloudflare.com/cdn-cgi/trace"
              },
              "failover": {
                "maxRetries": 3,
                "blacklistDuration": "5m",
                "fallbackToSingle": true
              },
              "evasion": {
                "enableRotation": true,
                "rotateInterval": "10m",
                "enableJitter": true
              }
            }
          }
        }
      }
    }
  },
  "security_limits": {
    "max_providers": 50,
    "max_provider_name_length": 64,
    "max_bug_domain_length": 253,
    "max_isps_per_provider": 20,
    "max_isp_name_length": 64,
    "priority_range": "1-100",
    "health_check_interval_range": "5s-1h",
    "health_check_timeout_range": "1s-30s",
    "blacklist_duration_range": "10s-1h",
    "rotate_interval_range": "1m-24h",
    "max_failover_retries": 10,
    "max_health_check_url_length": 2048,
    "allowed_url_schemes": ["http", "https"],
    "blocked_url_targets": ["loopback", "private IPs", "link-local", "multicast"]
  }
}
