{
  "description": "Multi-CDN Security Test Cases - These configs are REJECTED by the parser",
  "malicious_examples": {
    "1_too_many_providers": {
      "description": "Exceeds MaxProviders limit (50)",
      "error_expected": "too many providers: maximum 50 allowed",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": "/* 100 providers - exceeds limit */"
            }
          }
        }
      }
    },
    "2_negative_duration": {
      "description": "Negative health check interval",
      "error_expected": "healthCheck interval must be positive",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {"name": "test", "bugDomain": "example.com"}
              ],
              "healthCheck": {
                "interval": "-30s"
              }
            }
          }
        }
      }
    },
    "3_excessive_timeout": {
      "description": "Timeout exceeds maximum (30s)",
      "error_expected": "healthCheck timeout too long: maximum 30s",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {"name": "test", "bugDomain": "example.com"}
              ],
              "healthCheck": {
                "timeout": "999999h"
              }
            }
          }
        }
      }
    },
    "4_ssrf_file_scheme": {
      "description": "SSRF attempt using file:// scheme",
      "error_expected": "healthCheck URL must use http or https scheme",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {"name": "test", "bugDomain": "example.com"}
              ],
              "healthCheck": {
                "url": "file:///etc/passwd"
              }
            }
          }
        }
      }
    },
    "5_ssrf_loopback": {
