            }
          }
        }
      }
    },
    "7_ssrf_link_local": {
      "description": "SSRF attempt targeting link-local address",
      "error_expected": "healthCheck URL target is not a valid public address",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
