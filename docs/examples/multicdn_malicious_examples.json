    "12_invalid_priority_range": {
      "description": "Priority outside valid range (1-100)",
      "error_expected": "priority must be between 1 and 100",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {"name": "test", "bugDomain": "example.com", "priority": 999}
