        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
              "providers": [
                {"name": "test", "bugDomain": "example.com"}
              ],
              "healthCheck": {
                "url": "http://127.0.0.1/admin"
              }
            }
          }
        }
      }
    },
    "6_ssrf_private_ip": {
      "description": "SSRF attempt targeting private IP",
      "error_expected": "healthCheck URL cannot target private IP",
      "config": {
        "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
            "serverName": "onering-multi:example.com",
            "multiCDN": {
              "enabled": true,
